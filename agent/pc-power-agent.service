[Unit]
Description=PC Power agent (CPU/GPU power for Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /usr/local/lib/pc-power/pc_power_agent.py --config /etc/pc-power/config.toml
Restart=always
RestartSec=5
# ddcutil keeps a display cache; give it somewhere writable under ProtectSystem=strict
CacheDirectory=pc-power
Environment=XDG_CACHE_HOME=/var/cache/pc-power
# root is required for RAPL energy_uj, /dev/i2c-* (monitors) and systemctl suspend/poweroff;
# CAP_NET_ADMIN is needed to read Wake-on-LAN state. Everything else is locked down.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
